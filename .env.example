# `./setup.sh` fills this file's counterpart (.env.local) in interactively.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Where everything durable lives: the auth database (auth.db) and one JSON file
# per project. Defaults to ./data. In Docker this must be a mounted volume, and
# it is what persists across container rebuilds.
# DATA_DIR=./data

# Realtime collaboration is on by default and served on the app's own port at
# /collab — there is no URL or port to configure. The token route signs room
# tokens with COLLAB_TOKEN_SECRET and the socket verifies them; the server
# refuses to start without it. NEXT_PUBLIC_COLLAB=off (build time) disables
# collaboration and the designer falls back to single-player editing with Save.
COLLAB_TOKEN_SECRET=
# NEXT_PUBLIC_COLLAB=off

# /forgot-password sets a new password immediately — there is no mail transport
# to confirm ownership of the address, so anyone who knows a registered email can
# take that account over. Set to false on any deployment that cannot accept that.
# ALLOW_DIRECT_PASSWORD_RESET=false
