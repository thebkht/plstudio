# `./setup.sh` fills this file's counterpart (.env.local) in interactively.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Where everything durable lives: the auth database (auth.db) and one JSON file
# per project. Defaults to ./data. In Docker this must be a mounted volume, and
# the web and collab services must mount the same one.
# DATA_DIR=./data

# Realtime collaboration. Both services must share COLLAB_TOKEN_SECRET: the web
# app signs room tokens with it, the collab server verifies them.
# Leaving NEXT_PUBLIC_COLLAB_URL unset disables collaboration and the designer
# falls back to single-player editing with the debounced PUT.
COLLAB_TOKEN_SECRET=
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
COLLAB_PORT=1234
